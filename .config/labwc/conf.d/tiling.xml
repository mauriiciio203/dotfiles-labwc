<labwc_config>
  <keyboard>
    <default />
    
    <!-- Cerrar ventana activa con Super + Q -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>

    <!-- Tiling manual (Mitades y Maximizar) -->
    <keybind key="W-Left">
      <action name="Unmaximize" />
      <action name="MoveTo" x="0" y="0" />
      <action name="ResizeTo" width="50%" height="100%" />
    </keybind>
    <keybind key="W-Right">
      <action name="Unmaximize" />
      <action name="MoveTo" x="50%" y="0" />
      <action name="ResizeTo" width="50%" height="100%" />
    </keybind>
    <keybind key="W-Up">
      <action name="Unmaximize" />
      <action name="MoveTo" x="0" y="0" />
      <action name="ResizeTo" width="100%" height="50%" />
    </keybind>
    <keybind key="W-Down">
      <action name="Unmaximize" />
      <action name="MoveTo" x="0" y="50%" />
      <action name="ResizeTo" width="100%" height="50%" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
  </keyboard>
</labwc_config>
