#!/bin/sh

export XDG_RUNTIME_DIR="/run/user/$(id -u)"

# Iniciar sesión D-Bus si no existe
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    eval $(dbus-launch --sh-syntax)
fi

# Iniciar servidor de audio PipeWire en orden
pipewire >/dev/null 2>&1 &
sleep 1
wireplumber >/dev/null 2>&1 &
pipewire-pulse >/dev/null 2>&1 &

# Portales para captura de pantalla (OBS)
/usr/libexec/xdg-desktop-portal-wlr >/dev/null 2>&1 &
/usr/libexec/xdg-desktop-portal -r >/dev/null 2>&1 &

# Restaurar tema Pywal y fondo de pantalla
wal -R -n -q 2>/dev/null || true
swaybg -i "/home/eniplax/Pictures/Wallpapers/europeana-SMMPyqhvRUY-unsplash.jpg" -m fill >/dev/null 2>&1 &
